# Supabase — public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App — optional. The site URL is auto-derived from the request's Host header
# at runtime; this is only used by background jobs or email callbacks when no
# request context is available. Do NOT prefix with NEXT_PUBLIC_ (server-only).
# SITE_URL=https://your-domain.com

# Anthropic — server-only, used for AI engagement summaries and lead scoring.
# AI features return a clear error if this is unset; the app otherwise works.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# Optional model override (defaults to claude-sonnet-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Job queue — shared secret the Vercel Cron (or any scheduler) sends in the
# Authorization header to drain /api/jobs/tick. Required in production.
JOBS_RUNNER_SECRET=change-me-to-a-long-random-string
