# Supabase — public (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App — optional. The site URL is auto-derived from the request's Host header
# at runtime; this is only used by background jobs or email callbacks when no
# request context is available. Do NOT prefix with NEXT_PUBLIC_ (server-only).
# SITE_URL=https://your-domain.com
